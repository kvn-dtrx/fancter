# ---
# title: Gitignore for Fancter
# ---

# ---

# dia:begin gitignore/base.ignore

# --- Base ---

# macOS
.AppleDouble
.DS_Store
.LSOverride
.Spotlight-V100
.Trashes
._*
* [0-9]
* [0-9].*
* copy
* copy.*
*.nosync/
Icon[[]]

# Linux
.nfs*
*~

# Windows
$RECYCLE.BIN/
Desktop.ini
ehthumbs.db
Thumbs.db

# Logs, temporary files, regenerable cache
*.bak
*.bak[0-9]*
*.bkp
*.cache
*.log
*.old
*.swn
*.swns
*.swo
*.swp
*.tmp
*.tmp.*
*_tmp.*
build/
cache/
.cache/
log/
.log/
logs/
.logs/
tmp/
.tmp/

# Local mountpoints
mnt/
mount/
mounts/

# Scripting-language artefacts
*.py[cod]
*.rbc
.ruby-lsp/
__pycache__/

# Local environment variables
.env
.env.*
env/
env.bak/

# Local configuration overrides
*.local
*.local.*

# dia:end

# dia:begin gitignore/latex.ignore

# --- LaTeX ---

# Core latex/pdflatex auxiliary files
.*.lb
*.aux
*.cb
*.cb2
*.fls
*.fmt
*.fot
*.gz
*.lof
*.log
*.lot
*.ownaux
*.out
*.thms
*.toc
*.wrt
*.xwm

# Generated if empty string is given at "Please type another file name for output:"
.dvi
.pdf
.ps

# Archaic output formats
*.dvi
*.ps

# Bibliography auxiliary files (bibtex/biblatex/biber)
*.bbl
*.bbl-SAVE-ERROR
*.bcf
*.bcf-SAVE-ERROR
*.blg
*-blx.aux
*-blx.bib
*.run.xml

# Build tool auxiliary files
*.fdb_latexmk
*.synctex
*.synctex(busy)
*.synctex.gz
*.synctex.gz(busy)

# Build directory
**/build/

# Beamer
*.nav
*.snm

# amsthm
*.thm

# glossaries
*.acn
*.acr
*.glg
*.glg-abr
*.glo
*.glo-abr
*.gls
*.gls-abr
*.glsdefs
*.lzo
*.lzs
*.slg
*.slo
*.sls

# makeidx
*.idx
*.ilg
*.ind

# dia:end
