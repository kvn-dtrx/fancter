% ---
% description: Invoice Table for Letters
% ---

\NeedsTeXFormat{LaTeX2e}

\ProvidesPackage{mlttr-invoice-table}[%
  2019/01/01 v0.0-dev Invoice Table for Letters%
]

% Very helpful references for creating this package:
% [Rechnungen schreiben mit KOMA-Script](https://texwelt.de/fragen/5693/)
% [Rechnungsposte um pauschale Einträge erweitern](https://texwelt.de/fragen/13919/)

% ---

% tabularx - Tabulars with adjustable-width columns.
\RequirePackage{tabularx}

% booktabs - Publication quality tables in LaTeX.
\RequirePackage{booktabs}

% numprint - Print numbers with separators and exponent if necessary.
\RequirePackage{numprint}

% fp - Fixed point arithmetic.
\RequirePackage{fp}

% Number of decimals to round numbers when they are printed.
\nprounddigits{2}

% datatool - Tools to load and manipulate data
\RequirePackage{datatool}
% WARNING datatool is very petulant with respect
% to blank spaces around equality signs,
% blank spaces after kommas, ...
% in hard conflict with the author's habits!

\DTLnewdb{invoicetable}

\newcommand{\invoiceitem}[3]{%
  \DTLnewrow{invoicetable}
  \DTLnewdbentry{invoicetable}{description}{#1}
  \DTLnewdbentry{invoicetable}{quantity}{#2}
  \DTLnewdbentry{invoicetable}{unitprice}{#3}
  \begingroup
  \dtlexpandnewvalue
  \FPeval\fpresult{round(#2*#3)(2)}
  \DTLnewdbentry{invoicetable}{totalprice}{\fpresult}
  \endgroup
}

\newcommand*{\VATrate}{}

\newcommand*{\prepare@table}[1]{%
  \renewcommand*{\VATrate}{#1}%
  \DTLcleardb{invoicetable}%
}

\newcommand*{\compute@cumulativesum}{%
  \def\cumulativesum{0}%
  \DTLforeach*{invoicetable}{\totalprice=totalprice}{\FPeval\cumulativesum{\cumulativesum+\totalprice}}%
  \xdef\cumulativesum{\cumulativesum}%
}

\newcommand*{\compute@totalsum}{%
  \FPeval\VAT{round(\VATrate*\cumulativesum/100)(2)}%
  \FPeval\totalsum{round(\cumulativesum+\VAT)(2)}%
  \xdef\totalsum{\totalsum}%
}

\def\Totalsum{\numprint{\totalsum}\,€}

\newcommand{\print@table}{%
  \par\centering
  \begin{tabularx}{\textwidth}{Xrrr}
    \toprule
    Bezeichnung                   & Anzahl                                          & Einzelpreis [€]       & Gesamtpreis [€]
    \DTLforeach*{invoicetable}{%
      \DESCRIPTION=description,\QUANTITY=quantity,\UNITPRICE=unitprice,\TOTALPRICE=totalprice%
    }{%
    \DTLiffirstrow{                                                                                                                     \\\midrule}{\\}%
    \DESCRIPTION                  & \npnoround\numprint{\QUANTITY}\nprounddigits{2} & \numprint{\UNITPRICE} & \numprint{\TOTALPRICE}    %
    }                                                                                                                                   \\
    \midrule
    \if \VATrate 0 \else
    Zwischensumme                 &                                                 &                       & \numprint{\cumulativesum} \\
    Mehrwertsteuer (\VATrate\,\%) &                                                 &                       & \numprint{\VAT}           \\
      \midrule
    \fi
    Summe                         &                                                 &                       & \numprint{\totalsum}      \\
    \bottomrule
  \end{tabularx}
  \par
}


\newenvironment{invoicetable}[1]{%
  \prepare@table{#1}
}{%
  \compute@cumulativesum%
  \compute@totalsum%
  \print@table%
}

\newcommand{\printbankdata}{%
  {\centering\usekomavar{bankdata}\par}%
}
